<Window x:Class="UnloyalFront.UI.LaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unloyal Front" Width="420" Height="150"
        WindowStartupLocation="CenterScreen" WindowStyle="ToolWindow" ResizeMode="NoResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}">
    <StackPanel VerticalAlignment="Center" Margin="28,0">
        <TextBlock Text="Unloyal Front" FontSize="18" FontWeight="Bold"/>
        <TextBlock x:Name="StatusText" Text="Starting..." Foreground="{StaticResource Muted}" Margin="0,6,0,12"/>
        <ProgressBar x:Name="Bar" Height="8" Minimum="0" Maximum="100" Value="0"
                     Foreground="{StaticResource Accent}" Background="{StaticResource Panel2}" BorderThickness="0"/>
    </StackPanel>
</Window>
